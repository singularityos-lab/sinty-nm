[Unit]
Description=Sinty Network Manager (NetworkManager-compatible)
Documentation=https://github.com/singularityos-lab/sinty-nm
After=dbus.service
Wants=iwd.service
After=iwd.service

[Service]
Type=dbus
BusName=org.freedesktop.NetworkManager
ExecStart=/usr/bin/sinty-nmd
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
